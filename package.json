{
	"name": "@forgeax/interface",
	"version": "0.9.5",
	"type": "module",
	"description": "ForgeaX product interface shell and application composition boundary.",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ForgeaX-Games/forgeax-interface.git"
	},
	"engines": {
		"node": ">=20.10"
	},
	"files": [
		"dist/package",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"sideEffects": [
		"**/*.css"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/package/browser/index.d.ts",
			"browser": "./dist/package/browser/index.js",
			"import": "./dist/package/node/index.js"
		},
		"./brand": {
			"types": "./dist/package/browser/brand/index.d.ts",
			"browser": "./dist/package/browser/brand/index.js",
			"import": "./dist/package/node/brand/index.js"
		},
		"./components/ModelPicker": {
			"types": "./dist/package/browser/components/ModelPicker/index.d.ts",
			"browser": "./dist/package/browser/components/ModelPicker/index.js",
			"import": "./dist/package/node/components/ModelPicker/index.js"
		},
		"./core/panels": {
			"types": "./dist/package/browser/core/panels/index.d.ts",
			"browser": "./dist/package/browser/core/panels/index.js",
			"import": "./dist/package/node/core/panels/index.js"
		},
		"./core/app-shell": {
			"types": "./dist/package/browser/core/app-shell/index.d.ts",
			"browser": "./dist/package/browser/core/app-shell/index.js",
			"import": "./dist/package/node/core/app-shell/index.js"
		},
		"./core/page-platform": {
			"types": "./dist/package/browser/core/page-platform/index.d.ts",
			"browser": "./dist/package/browser/core/page-platform/index.js",
			"import": "./dist/package/node/core/page-platform/index.js"
		},
		"./i18n": {
			"types": "./dist/package/browser/i18n/index.d.ts",
			"browser": "./dist/package/browser/i18n/index.js",
			"import": "./dist/package/node/i18n/index.js"
		},
		"./lib/platform": {
			"types": "./dist/package/browser/lib/platform/index.d.ts",
			"browser": "./dist/package/browser/lib/platform/index.js",
			"import": "./dist/package/node/lib/platform/index.js"
		},
		"./*.css": "./dist/package/browser/*.css",
		"./assets/*": "./dist/package/browser/assets/*",
		"./*": {
			"types": "./dist/package/browser/*.d.ts",
			"browser": "./dist/package/browser/*.js",
			"import": "./dist/package/node/*.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bun run build:package",
		"build:package": "bun scripts/build-package.mjs",
		"check": "bun run lint && bun run lint:agnostic && bun run lint:dep && bun run test && bun test scripts/*.test.ts && bun run build:package",
		"release:preflight": "bun scripts/check-release-package.mjs",
		"prepack": "bun run build:package",
		"test": "bun test ./src/lib/*.test.ts ./src/lib/dialog-renderer.test.tsx ./src/lib/**/*.test.ts ./src/components/*.test.ts ./src/components/*.test.tsx ./src/components/**/*.test.ts ./src/components/**/*.test.tsx ./src/components/**/__tests__/*.test.ts ./src/components/**/__tests__/*.test.tsx ./src/store-parts/*.test.ts ./src/store-parts/**/*.test.ts ./src/core/page-platform/*.test.ts ./src/core/app-shell/*.test.ts ./src/appHostBootstrap.test.ts && bun test ./src/lib/composer-insert-renderer.test.tsx",
		"lint": "bun run lint:types && bun run lint:biome",
		"lint:types": "tsc --noEmit -p tsconfig.lint.json",
		"lint:biome": "biome check --config-path=biome.json . --diagnostic-level=error",
		"lint:agnostic": "bun scripts/check-agnostic-boundary.ts",
		"lint:dep": "depcruise -c .dependency-cruiser.cjs src",
		"lint:fix": "biome check --config-path=biome.json --write .",
		"lint:staged": "lint-staged",
		"hooks:install": "lefthook install"
	},
	"dependencies": {
		"@forgeax/app-shell": "0.104.0",
		"@forgeax/extension-host": "0.3.2",
		"@forgeax/extension-platform": "0.7.0",
		"@forgeax/toolkit": "0.1.2",
		"@forgeax/types": "^0.1.3",
		"@radix-ui/react-alert-dialog": "^1.1.20",
		"@radix-ui/react-checkbox": "^1",
		"@radix-ui/react-dialog": "^1.1.20",
		"@radix-ui/react-dropdown-menu": "^2.1.21",
		"@radix-ui/react-popover": "^1.1.20",
		"@radix-ui/react-select": "^2.3.4",
		"@radix-ui/react-slot": "^1.3.0",
		"@radix-ui/react-tooltip": "^1.2.13",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-os": "^2",
		"@tauri-apps/plugin-shell": "^2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.0.4",
		"dockview": "^6.6.1",
		"lucide-react": "^0.460.0",
		"tailwind-merge": "^3.5.0",
		"zustand": "^5.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@happy-dom/global-registrator": "^20.10.2",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"autoprefixer": "^10.4.20",
		"dependency-cruiser": "^17.4.3",
		"postcss": "^8.5.14",
		"tailwindcss": "^3.4.19",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^5.6.3",
		"vite": "^8.0.16",
		"lefthook": "2.1.14",
		"lint-staged": "16.4.0"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"lint-staged": {
		"*": "biome check --config-path=biome.json --write --no-errors-on-unmatched --files-ignore-unknown=true"
	}
}
